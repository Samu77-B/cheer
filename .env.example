# Create a project at https://sanity.io/manage — use the same IDs for studio and sync.

SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

SANITY_PROJECT_ID=
SANITY_DATASET=production

# Optional: only needed if the dataset is private (public read is fine for most marketing sites)
SANITY_API_READ_TOKEN=

# Needed only for `npm run cms:seed` — Editor token from Sanity → API → Tokens
SANITY_WRITE_TOKEN=
